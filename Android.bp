package {
    default_applicable_licenses: ["hardware_floral_display_license"],
}

license {
    name: "hardware_floral_display_license",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-Apache-2.0"],
    license_text: ["LICENSE"],
}

cc_defaults {
    name: "floral_display_common_defaults",
    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
        "-Wthread-safety",
    ],
    cpp_std: "c++17",
    local_include_dirs: ["include"],
}

cc_library_headers {
    name: "floral_display_gralloc_metadata_headers",
    vendor_available: true,
    export_include_dirs: ["include"],
}

cc_library_static {
    name: "libfloral_display_core",
    defaults: ["floral_display_common_defaults"],
    vendor_available: true,
    header_libs: [
        "libbase_headers",
        "libcutils_headers",
    ],
    export_header_lib_headers: [
        "libbase_headers",
        "libcutils_headers",
    ],
    srcs: [
        "src/DisplayConfig.cpp",
        "src/DisplayTopology.cpp",
        "src/Edid.cpp",
        "src/FrameSink.cpp",
        "src/VsyncThread.cpp",
    ],
    export_include_dirs: ["include"],
}

cc_library_static {
    name: "libfloral_display_stream_bridge",
    defaults: ["floral_display_common_defaults"],
    vendor_available: true,
    header_libs: [
        "floral_display_gralloc_metadata_headers",
        "libbase_headers",
        "libcutils_headers",
        "libhardware_headers",
    ],
    srcs: [
        "src/AidlFrameConsumerEndpoint.cpp",
        "src/GraphicBufferClientTargetResolver.cpp",
        "src/StreamFrameSink.cpp",
    ],
    static_libs: [
        "libaidlcommonsupport",
    ],
    shared_libs: [
        "android.hardware.common-V2-ndk_platform",
        "android.hardware.graphics.common-V2-ndk_platform",
        "floral.stream.display-V1-ndk_platform",
        "libbinder_ndk",
        "libcutils",
        "libui",
    ],
    export_include_dirs: ["include"],
}

cc_defaults {
    name: "floral_display_hwc2_defaults",
    defaults: ["floral_display_common_defaults"],
    shared_libs: [
        "libbase",
        "libhardware",
        "liblog",
    ],
    static_libs: ["libfloral_display_core"],
}

cc_library_shared {
    name: "hwcomposer.floral",
    defaults: ["floral_display_hwc2_defaults"],
    vendor: true,
    relative_install_path: "hw",
    static_libs: [
        "libaidlcommonsupport",
        "libfloral_display_stream_bridge",
    ],
    shared_libs: [
        "android.hardware.common-V2-ndk_platform",
        "android.hardware.graphics.common-V2-ndk_platform",
        "floral.stream.display-V1-ndk_platform",
        "libbinder_ndk",
        "libcutils",
        "libui",
    ],
    srcs: [
        "src/Display.cpp",
        "src/DisplayRegistry.cpp",
        "src/HwcDevice.cpp",
        "src/Layer.cpp",
        "src/Module.cpp",
    ],
}

cc_test {
    name: "floral_display_tests",
    defaults: ["floral_display_hwc2_defaults"],
    vendor: true,
    static_libs: [
        "libaidlcommonsupport",
        "libfloral_display_stream_bridge",
    ],
    shared_libs: [
        "android.hardware.common-V2-ndk_platform",
        "android.hardware.graphics.common-V2-ndk_platform",
        "floral.stream.display-V1-ndk_platform",
        "libbinder_ndk",
        "libcutils",
        "libnativewindow",
        "libui",
    ],
    srcs: [
        "src/Display.cpp",
        "src/DisplayRegistry.cpp",
        "src/Layer.cpp",
        "tests/AidlFrameConsumerEndpointTest.cpp",
        "tests/DisplayConfigTest.cpp",
        "tests/DisplayFrameSinkTest.cpp",
        "tests/DisplayRefreshRateTest.cpp",
        "tests/DisplayRegistryTest.cpp",
        "tests/DisplayTopologyTest.cpp",
        "tests/EdidTest.cpp",
        "tests/FrameSinkTest.cpp",
        "tests/GraphicBufferClientTargetResolverTest.cpp",
        "tests/StreamFrameSinkTest.cpp",
    ],
    test_suites: ["device-tests"],
}
